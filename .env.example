# NextAuth / Auth.js — generate secret with: openssl rand -base64 32
AUTH_SECRET=
# Auth.js v5 canonical URL (use production domain on Vercel)
AUTH_URL=http://localhost:3000
# Legacy alias (optional if AUTH_URL is set)
NEXTAUTH_URL=http://localhost:3000

# Public app URL (must match production domain for OAuth on Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://strivo-brown.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon PostgreSQL (pooler URL for app + Vercel)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Pusher (Phase 4+)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# Anthropic Claude API — required for real AI Study Buddy chat (get key at console.anthropic.com)
ANTHROPIC_API_KEY=

# UploadThing (Phase 2+)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Feedback (Resend email to app owner)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Strivo <onboarding@resend.dev>
FEEDBACK_OWNER_EMAIL=

# Cron (Vercel — pair request expiry)
CRON_SECRET=
